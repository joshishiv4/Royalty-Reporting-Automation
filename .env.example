# =============================================================================
# royalty-sync-service - example environment file
#
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored. NEVER commit real values to this file or any other.
#
# Every value below is a PLACEHOLDER. Real values live in the secrets manager -
# see docs/RUNBOOK.md
# =============================================================================

# Which environment bundle to load: dev | prod
APP_ENV=dev

# Where the app reads its settings from:
#   file                 config/settings.<APP_ENV>.json  (recommended for local dev)
#   env                  this file / injected env vars   (CI, Vercel)
#   aws-secrets-manager  one JSON secret per environment (deployed)
SECRETS_PROVIDER=env

# file provider only: directory holding settings.<APP_ENV>.json (default: config)
# SETTINGS_DIR=config

# --- aws-secrets-manager provider only (ignored when SECRETS_PROVIDER=env) ----
# The provider reads ONE JSON secret per environment, named:
#   <prefix>/<APP_ENV>/config
# AWS_REGION=<aws-region>
# SECRETS_PREFIX=royalty-sync

# =============================================================================
# The values below are only read when SECRETS_PROVIDER=env.
# All of them are per-environment. dev and prod differ - do not assume either.
# =============================================================================

# --- WellnessLiving ----------------------------------------------------------
# Host WITHOUT protocol or trailing slash. dev and prod hosts are different.
WL_API_HOST=<wl-api-host-for-this-environment>
# Token host, WITHOUT protocol. WL serves /oauth2/token from a DIFFERENT host
# than the data endpoints - pointing this at WL_API_HOST returns a challenge
# page instead of a token.
WL_AUTH_HOST=<wl-auth-host-for-this-environment>
# Region id as an integer. dev and prod regions are different.
WL_ID_REGION=<wl-id-region-for-this-environment>
# Business key as a string.
WL_K_BUSINESS=<wl-k-business-for-this-environment>
WL_CLIENT_ID=<wl-oauth2-client-id>
WL_CLIENT_SECRET=<wl-oauth2-client-secret>

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=<https://your-project-ref.supabase.co>
# Service role key. RLS-bypassing - sync workers only, never the portal.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# --- GoHighLevel -------------------------------------------------------------
# Host WITHOUT protocol or trailing slash.
GHL_API_HOST=<ghl-api-host-for-this-environment>
# Date-stamped API contract this build was written against, e.g. 2021-07-28.
# Sent as the `Version` header on every call. Bumping this is a coordinated
# code + config change, not a config-only tweak - the parsers are pinned to
# the shape this version returns.
GHL_API_VERSION=<ghl-api-version-yyyy-mm-dd>
GHL_API_TOKEN=<ghl-private-integration-token>
GHL_LOCATION_ID=<ghl-location-id>

# --- deployed HTTP routes ----------------------------------------------------
# Bearer token for GET/POST /api/wellness-sync. UNSET MEANS LOCKED, not open.
# On Vercel, setting CRON_SECRET instead lets the schedule in automatically -
# Vercel sends it as the bearer. Either variable is accepted.
SYNC_TRIGGER_TOKEN=<a-long-random-string>

# --- optional runtime tuning (defaults live in src/config/schema.ts) ---------
# LOG_LEVEL=info
# Append every line to <LOG_DIR>/app.log and errors to error.log.
# Leave off for Vercel: its filesystem is read-only apart from an
# ephemeral /tmp, so read the platform log stream there instead.
# LOG_TO_FILE=false
# LOG_DIR=logs
# WL_MAX_CONCURRENCY=5
# WL_MAX_CONCURRENCY bounds how many calls are in flight at once.
# It is NOT a request rate: WellnessLiving publishes no rate limit and this
# service does not invent one.

# --- SMTP: dead-letter failure notifications ---------------------------------
# Set SMTP_HOST to turn the notifier on. When it is unset (the default), the
# service still summarises dead-letter items to the logs but sends no mail -
# useful for local dev where you do not want an inbox filling up.
#
# For a free live test, use Gmail SMTP:
#   Enable 2FA on the Google account, then create an App Password at
#   https://myaccount.google.com/apppasswords and use that as SMTP_PASSWORD.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<your-google-account@gmail.com>
# SMTP_PASSWORD=<16-character-app-password>
# SMTP_FROM=<your-google-account@gmail.com>
# Recipient defaults to shiv.joshi@aliansoftware.net; override here if needed.
# SMTP_TO=shiv.joshi@aliansoftware.net
