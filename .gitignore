# ---- secrets: nothing in this block may ever be committed ----
.env
.env.*
!.env.example
*.env
secrets.json
secrets.*.json
*.pem
*.key
*.p12
*.pfx
credentials
credentials.*
.aws/
.doppler/
service-account*.json

# ---- per-environment settings files: real ones are never committed ----
config/settings.*.json
!config/settings.example.json

# ---- log files: may contain business data ----
logs/
*.log

# ---- node ----
node_modules/
dist/
coverage/
*.tsbuildinfo
npm-debug.log*
.eslintcache

# ---- local caches from probe scripts ----
04_Development/ghl-match/ghl_contacts.json
04_Development/ghl-match/*.json
__pycache__/
*.pyc
.venv/

# ---- os / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Local probe and one-off scripts. Read-only diagnostics and manual sync runs
# against the live database - useful to keep, but not part of the service and
# never reviewed, so they stay out of the repository.
scratchpad/
# Also the loose form, still written at the repo root by other sessions.
scratchpad-*.mjs
.vercel
.env*
