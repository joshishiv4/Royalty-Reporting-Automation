{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/health.ts": {
      "maxDuration": 60
    },
    "api/wellness-sync.ts": {
      "maxDuration": 60
    },
    "api/wellness-sync-all.ts": {
      "maxDuration": 60
    },
    "api/wellness-sync-historical.ts": {
      "maxDuration": 60
    },
    "api/alerts.ts": {
      "maxDuration": 60
    },
    "api/sync-job.ts": {
      "maxDuration": 60
    },
    "api/sync-status.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/alerts",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
